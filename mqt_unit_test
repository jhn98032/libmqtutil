# Operate on unit tests file in the current directory.
# The directory must contain one pro file per unit test.
#

import subprocess
import sys
import os
import argparse
from enum import Enum

class color:
   BLUE = '\033[94m'
   BOLD = '\033[1m'
   UNDERLINE = '\033[4m'
   END = '\033[0m'

def print_status(text):
    print(color.BOLD + text + color.END)

def find_pro_files(dirname):
    pro_files = []
    for f in os.listdir(dirname):
        if f.endswith(".pro"):
            pro_files += [f]
    return pro_files



def do_compile(pro_files):
    for f in pro_files:
        #
        print_status(f"Creating makefile for {f}")
        subprocess.run(["qmake", f ])
        exe_name = "./" + f.replace(".pro", "")
   
        #
        print_status(f"Building {exe_name}")
        if subprocess.run(["make", exe_name ]).returncode:
            raise Exception("Failed to build program " + exe_name)
        
        #
        print_status(f"Running {exe_name}")
        if subprocess.run([exe_name]).returncode:
            raise Exception("Failed to execute program " + exe_name)
    
def do_clean(pro_files):

    for f in pro_files:
        print_status(f"Creating makefile for {f}")
        subprocess.run(["qmake", f ])
        print_status(f"Cleaning {f}")
        subprocess.run(["make", "-s", "clean" ])





def doit(argv):
    parser = argparse.ArgumentParser(epilog='',
                                     description="Operate on unittests described by one qmake .pro file for each test.")

    class CmdType(Enum):
        compile = 'compile'
        clean = 'clean'
        run = 'run'
    
    parser.add_argument('-C','--dir', type=str, 
                        help='Sets the directory that contain the pro files')
    parser.add_argument('CMD', type=str,
                        help=f"Choose from: {', '.join(e.name for e in CmdType)}.")
    args = parser.parse_args(argv)
    
    # Change directory
    if args.dir:
        rootdir = args.dir
        print("Changing dir to " + rootdir)
        os.chdir(rootdir)
        
    # Scan for .pro files for all unit tests
    proj_list = find_pro_files(".")
    print("Found %d projects" % (len(proj_list)))
    
    if args.CMD == "compile":
        do_compile(proj_list)
    elif args.CMD == "run":
        do_compile(proj_list)
    elif args.CMD == "clean":
        do_clean(proj_list)
    else:
        parser.print_help()
        return -1
    return 0

# Main entry
if __name__ == "__main__":
    try:
        #doit(["compile"])
        doit(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        print(f"Error: {e.output.decode('utf-8').strip()}")
    except IOError as e:
        print("I/O error({0}): {1}".format(e.errno, e.strerror))
    except SystemExit as e:
        pass
        raise e
    except:
        print("Error occured")
        raise

